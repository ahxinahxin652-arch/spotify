{
  "name": "flac-converter",
  "version": "1.0.0",
  "description": "FLAC Audio Converter - Electron + Express + Vue",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.flacconverter.app",
    "productName": "FLACConverter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  }
}
