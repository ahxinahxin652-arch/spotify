// Prisma Schema for FlacConverter
// 使用 SQLite 作为本地数据库

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MusicLibrary {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  coverPath      String?
  recentPlayedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tracks Track[]

  @@map("music_libraries")
}

model Track {
  id          String   @id @default(uuid())
  libraryId   String
  name        String
  title       String?
  artist      String?
  artists     String?
  album       String?
  cover       String?
  duration    Float?
  path        String   @unique
  format      String
  size        Int      @default(0)
  modified    Float?
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  library MusicLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId])
  @@map("tracks")
}

model Artist {
  id       String  @id @default(uuid())
  name     String  @unique
  coverImg String? @map("cover_img")
  metadata String?

  @@map("artists")
}

